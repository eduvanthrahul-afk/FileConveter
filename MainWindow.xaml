<Window x:Class="OrbitConvert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbitConvert" Width="448" Height="448"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" Drop="Window_Drop">
  <Grid x:Name="Root" Width="448" Height="448" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1" />
    </Grid.RenderTransform>
    <Ellipse Width="424" Height="424" Fill="#EAF8F5F1" Stroke="#BFFFFFFF" StrokeThickness="2">
      <Ellipse.Effect>
        <DropShadowEffect BlurRadius="32" ShadowDepth="5" Opacity="0.28" Color="#382C4D" />
      </Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="396" Height="396" Fill="#28FFFFFF" Stroke="#35FFFFFF" StrokeThickness="1" />
    <Canvas x:Name="MenuCanvas" Width="448" Height="448" IsHitTestVisible="True" />
    <Border x:Name="CenterPlate" Width="148" Height="148" CornerRadius="74"
            Background="#FFF9F8F5" BorderBrush="#D8FFFFFF" BorderThickness="2"
            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
            MouseLeftButtonUp="CenterPlate_MouseLeftButtonUp">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="#43334F" />
      </Border.Effect>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="11,0">
        <TextBlock x:Name="CenterGlyph" Text="✦" FontFamily="Segoe UI Symbol" FontSize="23"
                   Foreground="#FF6C50D6" HorizontalAlignment="Center" Margin="0,0,0,5" />
        <TextBlock x:Name="CenterTitle" Text="Drop a file" FontFamily="Segoe UI Semibold"
                   FontSize="15" Foreground="#FF282433" HorizontalAlignment="Center"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="124" />
        <TextBlock x:Name="CenterHint" Text="Shift + drag · or browse" FontFamily="Segoe UI"
                   FontSize="10.5" Foreground="#FF777382" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="124" />
      </StackPanel>
    </Border>
    <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,19,20,0" FontFamily="Segoe UI" FontSize="19" FontWeight="Light"
            Foreground="#FF777382" Background="#BFFFFFFF" BorderThickness="0" Cursor="Hand"
            Click="CloseButton_Click" ToolTip="Close (Esc)" />
  </Grid>
</Window>
